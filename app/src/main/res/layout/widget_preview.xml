<?xml version="1.0" encoding="utf-8"?>
<!-- Static picture shown in the launcher's widget picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/glass_digits"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0941"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/pill_frost_soft"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Wed 30 Sep  |  18°  Partly cloudy"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</LinearLayout>
