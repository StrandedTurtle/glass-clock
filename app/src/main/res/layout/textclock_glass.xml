<?xml version="1.0" encoding="utf-8"?>
<!-- Glass digits: a COLRv1 colour font, auto-sized to fill the box the widget gives it.
     Formats, colour and gravity are set per render from the widget settings. -->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clockText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoSizeMaxTextSize="400sp"
    android:autoSizeMinTextSize="12sp"
    android:autoSizeStepGranularity="1sp"
    android:autoSizeTextType="uniform"
    android:fontFamily="@font/glass_digits"
    android:format12Hour="hmm"
    android:format24Hour="HHmm"
    android:gravity="center"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="#FFFFFFFF" />
